generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String     @id @default(cuid())
  name        String
  framework   String     @default("OpenTelemetry / Generic")
  apiKey      String     @unique
  createdAt   DateTime   @default(now())
  services    Service[]
  spans       Span[]
  logs        LogEntry[]
  incidents   Incident[]
}

model Service {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  language    String   @default("nodejs")
  lastSeenAt  DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model Span {
  id             String   @id @default(cuid())
  projectId      String
  traceId        String
  spanId         String
  parentSpanId   String?
  serviceName    String
  operationName  String
  startTime      DateTime
  durationMs     Float
  statusCode     Int      @default(1) // 1 = OK, 2 = ERROR
  attributes     Json     @default("{}")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, traceId])
  @@index([projectId, serviceName, startTime])
}

model LogEntry {
  id          String   @id @default(cuid())
  projectId   String
  traceId     String?
  spanId      String?
  serviceName String
  severity    String   // INFO, WARN, ERROR
  body        String
  timestamp   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, traceId])
}

model Incident {
  id                  String   @id @default(cuid())
  projectId           String
  title               String
  status              String   @default("OPEN") // OPEN, RESOLVED
  severity            String   @default("CRITICAL")
  rootService         String
  affectedServices    String[]
  errorRatePeak       Float
  latencyPeakMs       Float
  traceId             String?
  evidencePacket      Json
  aiHypothesis        String
  aiRecommendations   Json
  confidenceScore     Int      @default(92)
  detectedAt          DateTime @default(now())
  resolvedAt          DateTime?
  recurrenceCount     Int       @default(0)
  regressionWarning   String?
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}